                            setValue("assetFields.unitMeasure", undefined);
                        }} value={field.value}>
                            <FormControl><SelectTrigger><SelectValue placeholder="Selecione..." /></SelectTrigger></FormControl>
                            <SelectContent>
                                <SelectItem value="Consumo">Consumo (Litros/m³)</SelectItem>
