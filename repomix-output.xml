                        <FormField
                            key={day.id}
                            control={form.control}
                            name="assetFields.homeOfficeDays"
                            render={({ field }) => {
                                const value = field.value || []; // Ensure array
                                return (
                                    <FormItem key={day.id} className="flex flex-row items-start space-x-3 space-y-0">
                                        <FormControl>
                                            <Checkbox
