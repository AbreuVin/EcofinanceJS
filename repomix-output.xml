                                    <FormLabel>Estado</FormLabel>
                                    <Select onValueChange={field.onChange} value={field.value}>
                                        <FormControl>
                                            <SelectTrigger className="w-full">
                                                <SelectValue placeholder="UF"/>
                                            </SelectTrigger>
                                        </FormControl>
                                        <SelectContent>
