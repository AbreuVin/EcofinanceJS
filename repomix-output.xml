                                ))}
                            </SelectContent>
                        </Select>
                        <FormMessage />
                    </FormItem>
                )}
            />

            {reportType === "Consumo" && (
                <>
                    <FormField
                        control={control}
                        name="assetFields.fuelType"
                        render={({ field }) => (
                            <FormItem>
                                <FormLabel>Combustível Padrão</FormLabel>
