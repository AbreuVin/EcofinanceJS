        .string()
        .min(18, "O CNPJ deve ter pelo menos 14 caracteres.")
        .regex(/^\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2}$/, "Formato de CNPJ inválido"),
});

export type CompanyFormValues = z.infer<typeof companyFormSchema>;
